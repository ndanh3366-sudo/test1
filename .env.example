# KIMI_API_KEY: Moonshot AI Official API key for Kimi K3.1 Pro (https://api.moonshot.ai/v1)
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.ai/v1"
KIMI_MODEL="kimi-k3.1-pro"

# DEEPINFRA_API_KEY: Optional DeepInfra API key if hosting Kimi via DeepInfra
DEEPINFRA_API_KEY=""
DEEPINFRA_KIMI_MODEL="moonshotai/Kimi-K3.1-Pro"

# GEMINI_API_KEY: Optional fallback for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Custom Firebase project for Authentication when deploying to custom/Vercel domains
# (Keeps Firestore connected to firebase-applet-config.json while allowing Google Sign-In on your Vercel domain)
VITE_FIREBASE_AUTH_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_AUTH_PROJECT_ID=""
VITE_FIREBASE_AUTH_APP_ID=""

# Optional: Supabase Realtime (cross-device live room, chat, WebRTC signaling & IP ban broadcast)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional: LiveKit Cloud / Self-hosted SFU credentials (configured on Node server, never expose secrets in client bundle)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Optional: WebRTC TURN relay credentials for strict mobile carrier / enterprise NAT
VITE_TURN_URLS=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
